msgstr "Säkert läge förhindrar att alla interna skript fördröjs."

#: inc/Engine/Admin/Settings/Page.php:704
msgid "Performance impact"
msgstr "Prestandapåverkan"

#: inc/Engine/Admin/Settings/Page.php:866
