<?xml version="1.0"?>
<ruleset name="Cache-Cache correctness">
    <description>First adoption: full changed-file compatibility, security and gettext checks. Formatting is outside this gate.</description>
    <config name="testVersion" value="7.4-"/>
    <config name="minimum_supported_wp_version" value="5.8"/>
    <rule ref="PHPCompatibilityWP"/>
    <rule ref="WordPress.Security.EscapeOutput"/>
    <!-- GET presence is also a public cache-admission condition, not necessarily a mutation. -->
    <rule ref="WordPress.Security.NonceVerification.Missing"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="noobrocket"/>
            </property>
        </properties>
    </rule>
</ruleset>
