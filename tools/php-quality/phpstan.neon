includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 1
    phpVersion: 70400
    tmpDir: ../../.artifacts/phpstan
    scanDirectories:
        - ../../noobrocket/inc
        - ../../noobrocket/vendor
    scanFiles:
        - ../../noobrocket/noobrocket.php
        - ../../noobrocket/uninstall.php
