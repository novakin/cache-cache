{
    "name": "cache-cache/php-quality",
    "description": "Isolated Cache-Cache PHP check tools; never install into the shipped plugin",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.2"
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    }
}
