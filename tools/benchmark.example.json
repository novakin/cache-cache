{
  "staging": true,
  "baseUrl": "https://staging.example.com",
  "environment": {
    "siteSnapshot": "database-and-uploads-snapshot-id",
    "server": "same-server-and-PHP-pool-id",
    "php": "8.4.26",
    "wordpress": "7.1.3",
    "theme": "theme-name-and-version"
  },
  "optimizationProfile": {
    "anonymousPageCache": true,
    "separateMobileCache": false,
    "cssMode": "used",
    "cssGenerationComplete": true,
    "cssMinification": true,
    "javascriptOptimization": "identical-settings",
    "cdn": "identical-CDN-settings",
    "preload": "complete-before-each-run"
  },
  "cacheEvidence": { "header": "x-benchmark-page-cache", "includes": "hit" },
  "repetitions": 5,
  "settleMs": 2000,
  "timeoutMs": 30000,
  "viewports": [
    { "name": "desktop", "width": 1365, "height": 900, "mobile": false },
    { "name": "mobile", "width": 390, "height": 844, "mobile": true }
  ],
  "pages": [
    { "name": "Homepage", "path": "/" },
    { "name": "Article", "path": "/example-article/" }
  ]
}
